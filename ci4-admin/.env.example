# KFESTA CI4 환경설정 예시 — 복사해서 .env로 저장 후 값 채우기 (.env는 커밋 금지)

CI_ENVIRONMENT = production

app.baseURL = 'https://kfesta.vn/'
app.indexPage = ''

# ── DB (MySQL 5.6, utf8mb4) ──────────────────────────
database.default.hostname = 127.0.0.1
database.default.database = kfesta
database.default.username = kfesta
database.default.password =
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# ── 세션 (회사 표준: DB 세션) ─────────────────────────
session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'
session.expiration = 28800
session.cookieName = 'kfesta_admin'

# ── KFESTA 전용 ──────────────────────────────────────
# 굽기 실행용 Node 경로 (PATH에 있으면 node 그대로)
kfesta.nodeBin = node
# 접수 시 구글시트 기록 + 메일 알림 (Apps Script /exec URL). 비우면 DB 저장만 한다.
kfesta.sheetEndpoint = 'https://script.google.com/macros/s/AKfycbwSEONilJdT522UxC_gAvYeDvrRsCk60GYiOFwy2MVPcYyRhoZK3NF-rTOW9TrtAyTU/exec'
